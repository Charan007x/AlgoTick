# Production Environment Variables Template
# Copy this to .env and fill in your actual values

# Server Configuration
NODE_ENV=production
PORT=5000

# Database
MONGODB_URI=mongodb+srv://algotick-user:YOUR_PASSWORD@algotick-cluster.xxxxx.mongodb.net/algotick?retryWrites=true&w=majority

# Upstash Redis — rate limiting ONLY
UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Cache Redis — dashboard / lists / AI coach
CACHE_REDIS_HOST=your-redis-host.example.com
CACHE_REDIS_PORT=6379
CACHE_REDIS_USERNAME=default
CACHE_REDIS_PASSWORD=your-redis-password
CACHE_REDIS_TLS=true

# Security - Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secure-jwt-secret-minimum-32-characters-long
SESSION_SECRET=your-super-secure-session-secret-minimum-32-characters

# Google OAuth (Production)
GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend URLs (Update with your actual Vercel URLs)
FRONTEND_URL=https://algotick.vercel.app
LANDING_URL=https://algotick-landing.vercel.app

# Callback URL (Render auto-generates this)
GOOGLE_CALLBACK_URL=https://algotick-backend.onrender.com/api/auth/google/callback
