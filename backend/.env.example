# Backend Environment Variables
# DO NOT commit .env file to Git! This is just an example.

# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/algotick

# Security (Generate strong random strings for production!)
JWT_SECRET=your-jwt-secret-here-use-strong-random-string
SESSION_SECRET=your-session-secret-here-use-strong-random-string

# Google OAuth (Optional - set these if you want OAuth login)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Frontend URLs
FRONTEND_URL=http://localhost:3000
LANDING_URL=http://localhost:3001

# Gemini AI API Key (Get from Google AI Studio: https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Production Setup:
# 1. Use strong random strings for JWT_SECRET and SESSION_SECRET
# 2. Set MONGODB_URI to your Atlas connection string
# 3. Set NODE_ENV=production
# 4. Update FRONTEND_URL and LANDING_URL to production URLs
# 5. Update GOOGLE_CALLBACK_URL if using OAuth
