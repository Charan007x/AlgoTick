{
  "manifest_version": 3,
  "name": "LeetCode Revision Tracker",
  "version": "1.0.0",
  "description": "Track and revise your solved LeetCode problems with spaced repetition reminders",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "notifications",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "http://localhost:5000/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LeetCode Tracker"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["http://localhost:3000/*"],
      "js": ["sync.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}
